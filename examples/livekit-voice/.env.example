# Copy to .env and fill in your real values. .env is git-ignored.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Powers both the live conversational LLM (via LiveKit Inference's
# openai plugin, withGroq()) and the post-call openrubric review.
GROQ_API_KEY=

# Optional overrides — defaults shown.
# STT_MODEL=deepgram/nova-3
# TTS_MODEL=cartesia/sonic-2
# VOICE_LLM_MODEL=openai/gpt-oss-120b
# REVIEW_MODEL=openai/gpt-oss-120b
