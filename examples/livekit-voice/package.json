{
  "name": "openrubric-livekit-voice-example",
  "version": "0.1.0",
  "private": true,
  "description": "A LiveKit Agents worker that interviews a candidate by voice, then reviews the call with openrubric on hangup.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/agent.ts dev",
    "start": "node --env-file=.env src/agent.ts start",
    "mint-token": "node --env-file=.env src/mint-token.mjs"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.4",
    "@livekit/agents-plugin-openai": "^1.6.4",
    "@livekit/agents-plugin-silero": "^1.6.4",
    "@livekit/protocol": "^1.50.4",
    "livekit-server-sdk": "^2.18.0",
    "openrubric": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "@livekit/local-inference@0.2.7": true,
    "onnxruntime-node@1.24.3": true
  }
}
